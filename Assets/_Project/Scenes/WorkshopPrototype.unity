      value: 344
      objectReference: {fileID: 0}
    - target: {fileID: 7319873744339971463, guid: 8035b147d8bde1d46a38c8de22f569d2, type: 3}
      propertyPath: m_Text
      value: "<b>\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 \xB7
        F1 \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C</b>\n\n<b>1 \u0420\u0443\u043A\u0430</b>
        \xB7 \u041B\u041A\u041C: \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C,
        \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u043D\u0430\u0434 \u0433\u043D\u0435\u0437\u0434\u043E\u043C \u0438\u043B\u0438
        \u043B\u043E\u0442\u043A\u043E\u043C.\n<b>2 \u041E\u0442\u0432\u0451\u0440\u0442\u043A\u0430</b>
        \xB7 \u041B\u041A\u041C + \u043A\u0440\u0443\u0433 \u0438\u043B\u0438 \u043A\u043E\u043B\u0435\u0441\u043E.
        \u2193 \u0432\u044B\u043A\u0440\u0443\u0442\u0438\u0442\u044C, \u2191 \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044C.\n<b>3
        \u0429\u0451\u0442\u043A\u0430</b> \xB7 \u041B\u041A\u041C + \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u043E \u0433\u0440\u044F\u0437\u0438.\n<b>4 \u041F\u0430\u044F\u043B\u044C\u043D\u0438\u043A</b>
        \xB7 \u041B\u041A\u041C + \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443; \u0440\u0430\u0437\u044A\u0451\u043C
        \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C.\n\n<b>\u041F\u041A\u041C
        + \u043C\u044B\u0448\u044C</b> \u2014 \u0432\u0440\u0430\u0449\u0430\u0442\u044C
        \u0440\u043E\u0431\u043E\u0442\u0430 \u043D\u0430 360\xB0.\n<b>\u041A\u043E\u043B\u0435\u0441\u043E</b>
        \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C / \u043E\u0442\u0434\u0430\u043B\u0438\u0442\u044C
        \u0440\u043E\u0431\u043E\u0442\u0430.\n<b>R</b> \u2014 \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u0442\u044C
        \u0440\u043E\u0431\u043E\u0442\u0430.\n<b>Esc</b> \u2014 \u0432\u044B\u0439\u0442\u0438
        \u0438\u0437 \u0432\u0435\u0440\u0441\u0442\u0430\u043A\u0430.\n<b>H</b>
        \u2014 \u0444\u0430\u043A\u0442\u044B \u0438 \u043F\u043E\u043C\u043E\u0449\u044C
        \u043F\u043E \u0434\u0438\u0430\u0433\u043D\u043E\u0437\u0443.\n\n<size=10>\u0418\u043A\u043E\u043D\u043A\u0438
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432:
        Icons8 (icons8.com)</size>"
      objectReference: {fileID: 0}
