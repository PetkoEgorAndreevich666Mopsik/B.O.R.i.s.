      value: 344
      objectReference: {fileID: 0}
    - target: {fileID: 7319873744339971463, guid: 8035b147d8bde1d46a38c8de22f569d2, type: 3}
      propertyPath: m_Text
      value: "<b>\u0421\u041F\u0420\u0410\u0412\u041A\u0410 \xB7 F1 \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C</b>\n\n<b>1
        \u0420\u0443\u043A\u0430</b> \xB7 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
        \u041B\u041A\u041C, \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438
        \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043D\u0430\u0434
        \u043C\u0435\u0441\u0442\u043E\u043C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438.\n<b>2
        \u041E\u0442\u0432\u0451\u0440\u0442\u043A\u0430</b> \xB7 \u041B\u041A\u041C
        + \u043A\u0440\u0443\u0433 \u0438\u043B\u0438 \u043A\u043E\u043B\u0435\u0441\u043E.
        \u2193 \u0432\u044B\u043A\u0440\u0443\u0442\u0438\u0442\u044C, \u2191 \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044C.\n<b>3
        \u0429\u0451\u0442\u043A\u0430</b> \xB7 \u041B\u041A\u041C + \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u043E \u0433\u0440\u044F\u0437\u0438.\n<b>4 \u041F\u0430\u044F\u043B\u044C\u043D\u0438\u043A</b>
        \xB7 \u041B\u041A\u041C + \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0443.\n\u041F\u0435\u0440\u0435\u0434
        \u043F\u0430\u0439\u043A\u043E\u0439 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
        \u0440\u0430\u0437\u044A\u0451\u043C; \u043F\u043E\u0441\u043B\u0435 \u2014
        \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C.\n\n<b>F</b>
        \u043E\u0441\u043C\u043E\u0442\u0440 \xB7 <b>\u041F\u041A\u041C</b> \u0440\u0430\u043A\u0443\u0440\u0441\n<b>\u041A\u043E\u043B\u0435\u0441\u043E</b>
        \u043C\u0430\u0441\u0448\u0442\u0430\u0431 \xB7 <b>Esc</b> \u0432\u044B\u0445\u043E\u0434"
      objectReference: {fileID: 0}
